#!/bin/bash
set -e

# Update desktop database
if command -v update-desktop-database >/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# Update icon cache
if command -v gtk-update-icon-cache >/dev/null; then
    gtk-update-icon-cache /usr/share/icons/hicolor || true
fi

# Update mime database just in case
if command -v update-mime-database >/dev/null; then
    update-mime-database /usr/share/mime || true
fi

# Create appi CLI symlink from config
CLI_NAME=$(python3 -c "import sys; sys.path.insert(0, '/usr/share/appinstall'); from src.config import CLI_NAME; print(CLI_NAME)" 2>/dev/null || echo "appi")
if [ ! -f "/usr/bin/$CLI_NAME" ]; then
    ln -sf /usr/bin/appinstall "/usr/bin/$CLI_NAME"
fi

# Add Inled APT Repository
REPO_URL="https://apt.inled.es"
KEY_URL="$REPO_URL/archive.key"
REPO_LIST="/etc/apt/sources.list.d/inled.list"

echo "Configurando repositorio de actualizaciones de Inled..."

# Descargar e instalar la llave GPG
if command -v curl >/dev/null; then
    curl -fsSL "$KEY_URL" | gpg --dearmor -o /usr/share/keyrings/inled-archive-keyring.gpg --yes
elif command -v wget >/dev/null; then
    wget -qO- "$KEY_URL" | gpg --dearmor -o /usr/share/keyrings/inled-archive-keyring.gpg --yes
fi

# Añadir el repositorio a las fuentes
echo "deb [signed-by=/usr/share/keyrings/inled-archive-keyring.gpg] $REPO_URL stable main" > "$REPO_LIST"

# Actualizar la caché de apt en segundo plano
apt-get update -o Dir::Etc::sourcelist="$REPO_LIST" -o Dir::Etc::sourceparts="-" -o APT::Get::List-Cleanup="0" || true
