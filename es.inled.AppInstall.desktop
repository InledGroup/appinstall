[Desktop Entry]
Name=App Install
Comment=Simple package installer for Linux
Exec=/usr/bin/appinstall %U
Icon=es.inled.AppInstall
Terminal=false
Type=Application
Categories=Utility;System;PackageManager;
StartupNotify=false
